# Copy to .env and fill in. .env is never tracked; config names these variables, never the values.
# A variable exported in the process environment wins over the file, so a deployment may inject
# instead of shipping a file. Format is KEY=VALUE only — `export KEY=VALUE` is rejected.

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Polygon. POLYGON_PRIVATE_KEY is 32 bytes of hex, `0x` prefix optional; SIGNER_ADDRESS is the
# address that key derives — examples/poly-probe reports a mismatch rather than leaving you to
# discover it at order-rejection time.
POLYGON_ADDRESS=
POLYGON_PRIVATE_KEY=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
SIGNER_ADDRESS=

# The maker address, which for a proxy wallet is NOT the signer above — run examples/poly-probe to
# discover it. Signature type: 0 EOA, 1 proxy, 2 Gnosis Safe, 3 deposit wallet.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=2
